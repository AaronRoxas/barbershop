# Public (safe for the browser). Copy this file to .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_DEFAULT_BUSINESS_SLUG=reference

# Optional canonical public website origin. Set the real URL before publishing a live shop.
# NEXT_PUBLIC_SITE_URL=https://your-barbershop.example

# Server-only. Never prefix with NEXT_PUBLIC_ and never import into Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
